<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WannaV 生徒様特典自動送付システム</title>
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }
    
    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', Meiryo, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 20px;
    }
    
    .container {
      max-width: 1400px;
      margin: 0 auto;
    }
    
    .header {
      background: white;
      padding: 30px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      margin-bottom: 30px;
    }
    
    .header h1 {
      color: #667eea;
      font-size: 28px;
      margin-bottom: 10px;
    }
    
    .header p {
      color: #666;
      font-size: 14px;
    }
    
    .status-card {
      background: white;
      padding: 25px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      margin-bottom: 30px;
    }
    
    .status-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
      gap: 20px;
      margin-top: 20px;
    }
    
    .status-item {
      text-align: center;
      padding: 20px;
      background: #f8f9fa;
      border-radius: 8px;
    }
    
    .status-item .label {
      font-size: 12px;
      color: #666;
      margin-bottom: 8px;
    }
    
    .status-item .value {
      font-size: 24px;
      font-weight: bold;
      color: #333;
    }
    
    .btn {
      background: #667eea;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
      transition: background 0.3s;
    }
    
    .btn:hover {
      background: #5568d3;
    }
    
    .btn:disabled {
      background: #ccc;
      cursor: not-allowed;
    }
    
    .btn-secondary {
      background: #6c757d;
      color: white;
      border: none;
      padding: 12px 24px;
      border-radius: 6px;
      font-size: 16px;
      cursor: pointer;
      transition: background 0.3s;
      margin-left: 10px;
    }
    
    .btn-secondary:hover {
      background: #5a6268;
    }
    
    .test-form {
      margin-top: 20px;
      padding: 20px;
      background: #f8f9fa;
      border-radius: 8px;
      border: 2px dashed #dee2e6;
    }
    
    .test-form h3 {
      margin-bottom: 15px;
      color: #495057;
      font-size: 16px;
    }
    
    .form-group {
      margin-bottom: 15px;
    }
    
    .form-group label {
      display: block;
      margin-bottom: 5px;
      font-weight: 600;
      color: #495057;
      font-size: 14px;
    }
    
    .form-group select {
      width: 100%;
      padding: 10px;
      border: 1px solid #ced4da;
      border-radius: 4px;
      font-size: 14px;
      background: white;
    }
    
    .test-info {
      margin-top: 10px;
      padding: 10px;
      background: #e7f3ff;
      border-left: 4px solid #0066cc;
      font-size: 12px;
      color: #004085;
    }
    
    .image-card {
      background: #f8f9fa;
      padding: 20px;
      border-radius: 8px;
      border: 1px solid #dee2e6;
    }
    
    .image-card h3 {
      margin-bottom: 15px;
      color: #495057;
      font-size: 16px;
      font-weight: 600;
    }
    
    .image-preview {
      min-height: 150px;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }
    
    .section {
      background: white;
      padding: 25px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0, 0, 0, 0.1);
      margin-bottom: 30px;
    }
    
    .section h2 {
      color: #333;
      font-size: 20px;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 2px solid #667eea;
    }
    
    table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }
    
    th {
      background: #667eea;
      color: white;
      padding: 12px;
      text-align: left;
      font-weight: 600;
    }
    
    td {
      padding: 12px;
      border-bottom: 1px solid #eee;
    }
    
    tr:hover {
      background: #f8f9fa;
    }
    
    .badge {
      display: inline-block;
      padding: 4px 12px;
      border-radius: 12px;
      font-size: 12px;
      font-weight: 600;
    }
    
    .badge-success {
      background: #d4edda;
      color: #155724;
    }
    
    .badge-error {
      background: #f8d7da;
      color: #721c24;
    }
    
    .badge-standard {
      background: #fff3cd;
      color: #856404;
    }
    
    .badge-premium {
      background: #d1ecf1;
      color: #0c5460;
    }
    
    .processing {
      color: #ff6b6b;
      font-weight: bold;
    }
    
    .timestamp {
      color: #999;
      font-size: 12px;
    }
    
    .empty-state {
      text-align: center;
      padding: 60px 20px;
      color: #999;
    }
    
    .empty-state svg {
      width: 100px;
      height: 100px;
      margin-bottom: 20px;
      opacity: 0.3;
    }
  </style>
</head>
<body>
  <div class="container">
    <div class="header">
      <h1>🎓 WannaV 生徒様特典自動送付システム</h1>
      <p>生徒様のランク達成に応じて自動的に特典メッセージをDiscordに送信します</p>
    </div>
    
    <div class="status-card">
      <h2 style="margin-bottom: 15px;">⚙️ システム状態</h2>
      
      <!-- 定期実行状態の表示 -->
      <div style="margin-bottom: 20px; padding: 15px; background: <%= cronEnabled ? '#d4edda' : '#fff3cd' %>; border-radius: 8px; border-left: 4px solid <%= cronEnabled ? '#28a745' : '#ffc107' %>;">
        <strong style="color: <%= cronEnabled ? '#155724' : '#856404' %>;">
          <%= cronEnabled ? '✅ 定期実行: 有効（毎日17時自動実行）' : '⏸️ 定期実行: 無効（手動実行のみ）' %>
        </strong>
        <p style="font-size: 12px; color: #666; margin-top: 5px;">
          <%= cronEnabled ? '自動実行が有効です。毎日17時に自動的にバッチ処理が実行されます。' : '定期実行が無効です。環境変数 ENABLE_CRON=true で有効化できます。' %>
        </p>
      </div>
      
      <% if (isProcessing) { %>
        <p class="processing">🔄 バッチ処理実行中...</p>
      <% } else { %>
        <button class="btn" onclick="runBatch()">▶️ 手動実行</button>
        <button class="btn-secondary" onclick="toggleTestForm()">🧪 テスト送信</button>
      <% } %>
      
      <!-- テスト送信フォーム -->
      <div class="test-form" id="testForm" style="display: none;">
        <h3>🧪 テスト送信</h3>
        <div class="test-info">
          📍 送信先: https://discord.com/channels/1176426605309083678/1293539258069417994（固定）
        </div>
        
        <div class="form-group">
          <label for="planType">プランタイプ</label>
          <select id="planType">
            <option value="">選択してください</option>
            <option value="スタンダードプラン">スタンダードプラン</option>
            <option value="レギュラープラン">レギュラープラン</option>
            <option value="プレミアムプラン">プレミアムプラン</option>
          </select>
        </div>
        
        <div class="form-group">
          <label for="benefitRank">特典ランク</label>
          <select id="benefitRank">
            <option value="">選択してください</option>
            <option value="10日達成">10日達成</option>
            <option value="ビギナーⅠ">ビギナーⅠ</option>
            <option value="ビギナーⅡ">ビギナーⅡ</option>
            <option value="ビギナーⅢ">ビギナーⅢ</option>
            <option value="ブロンズ">ブロンズ</option>
            <option value="シルバー">シルバー</option>
            <option value="ゴールド">ゴールド</option>
          </select>
        </div>
        
        <button class="btn" onclick="sendTest()">📤 テスト送信</button>
        <button class="btn-secondary" onclick="toggleTestForm()">キャンセル</button>
      </div>
      
      <div class="status-grid">
        <div class="status-item">
          <div class="label">最終実行日時</div>
          <div class="value timestamp">
            <%= lastRunTime ? formatDateTime(lastRunTime) : '未実行' %>
          </div>
        </div>
        
        <% if (lastRunResult) { %>
          <div class="status-item">
            <div class="label">送信成功</div>
            <div class="value" style="color: #28a745;"><%= lastRunResult.success %>件</div>
          </div>
          
          <div class="status-item">
            <div class="label">スキップ</div>
            <div class="value" style="color: #6c757d;"><%= lastRunResult.skipped %>件</div>
          </div>
          
          <div class="status-item">
            <div class="label">送信失敗</div>
            <div class="value" style="color: #dc3545;"><%= lastRunResult.failed %>件</div>
          </div>
        <% } %>
      </div>
    </div>
    
    <div class="section">
      <h2>📊 生徒様別送信履歴（最新状態）</h2>
      
      <% if (history && history.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>生徒名</th>
              <th>学籍番号</th>
              <th>プラン</th>
              <th>最後に送信した特典</th>
              <th>送信日時</th>
            </tr>
          </thead>
          <tbody>
            <% history.forEach(record => { %>
              <tr>
                <td><%= record.student_name %></td>
                <td><%= record.student_id %></td>
                <td>
                  <span class="badge <%= record.plan_type === 'プレミアムプラン' ? 'badge-premium' : 'badge-standard' %>">
                    <%= record.plan_type %>
                  </span>
                </td>
                <td><%= record.last_benefit_rank || '-' %></td>
                <td class="timestamp">
                  <%= record.last_sent_at ? formatDateTime(new Date(record.last_sent_at)) : '-' %>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <p>📭 まだ送信履歴がありません</p>
        </div>
      <% } %>
    </div>
    
    <div class="section">
      <h2>📝 送信ログ（直近50件）</h2>
      
      <% if (logs && logs.length > 0) { %>
        <table>
          <thead>
            <tr>
              <th>送信日時</th>
              <th>生徒名</th>
              <th>学籍番号</th>
              <th>特典ランク</th>
              <th>プラン</th>
              <th>状態</th>
            </tr>
          </thead>
          <tbody>
            <% logs.forEach(log => { %>
              <tr>
                <td class="timestamp"><%= formatDateTime(new Date(log.sent_at)) %></td>
                <td><%= log.student_name %></td>
                <td><%= log.student_id %></td>
                <td><%= log.benefit_rank %></td>
                <td>
                  <span class="badge <%= log.plan_type === 'プレミアムプラン' ? 'badge-premium' : 'badge-standard' %>">
                    <%= log.plan_type %>
                  </span>
                </td>
                <td>
                  <span class="badge <%= log.status === 'success' ? 'badge-success' : 'badge-error' %>">
                    <%= log.status === 'success' ? '成功' : '失敗' %>
                  </span>
                </td>
              </tr>
            <% }) %>
          </tbody>
        </table>
      <% } else { %>
        <div class="empty-state">
          <p>📭 まだ送信ログがありません</p>
        </div>
      <% } %>
    </div>
    
    <!-- 画像管理セクション -->
    <div class="section">
      <h2>🖼️ ランク別画像管理</h2>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px; margin-top: 20px;">
        <% const ranks = ['10日達成', 'ビギナーⅠ', 'ビギナーⅡ', 'ビギナーⅢ', 'ブロンズ', 'シルバー', 'ゴールド']; %>
        <% ranks.forEach(rank => { 
          const imageInfo = images.find(img => img.benefit_rank === rank);
        %>
          <div class="image-card" id="card-<%= rank %>">
            <h3><%= rank %></h3>
            <div class="image-preview" id="preview-<%= rank %>">
              <% if (imageInfo) { %>
                <img src="/api/image/<%= encodeURIComponent(rank) %>" alt="<%= rank %>" style="max-width: 100%; height: auto; border-radius: 4px;">
                <p style="font-size: 12px; color: #666; margin-top: 10px;">
                  <%= imageInfo.image_filename %> 
                  (<%= (imageInfo.image_size / 1024).toFixed(1) %> KB)
                </p>
              <% } else { %>
                <div style="padding: 40px; text-align: center; background: #f8f9fa; border-radius: 4px; color: #999;">
                  画像未設定
                </div>
              <% } %>
            </div>
            <div style="margin-top: 15px;">
              <input type="file" id="file-<%= rank %>" accept="image/*" style="display: none;" onchange="handleFileSelect('<%= rank %>')">
              <button class="btn" style="width: 100%; margin-bottom: 10px;" onclick="document.getElementById('file-<%= rank %>').click()">
                📤 画像をアップロード
              </button>
              <% if (imageInfo) { %>
                <button class="btn-secondary" style="width: 100%; background: #dc3545;" onclick="deleteImage('<%= rank %>')">
                  🗑️ 削除
                </button>
              <% } %>
            </div>
          </div>
        <% }) %>
      </div>
    </div>
  </div>
  
  <script>
    function toggleTestForm() {
      const form = document.getElementById('testForm');
      form.style.display = form.style.display === 'none' ? 'block' : 'none';
    }
    
    async function handleFileSelect(rank) {
      const fileInput = document.getElementById(`file-${rank}`);
      const file = fileInput.files[0];
      
      if (!file) return;
      
      // ファイルサイズチェック（10MB）
      if (file.size > 10 * 1024 * 1024) {
        alert('ファイルサイズは10MB以下にしてください');
        fileInput.value = '';
        return;
      }
      
      // 画像ファイルかチェック
      if (!file.type.startsWith('image/')) {
        alert('画像ファイルを選択してください');
        fileInput.value = '';
        return;
      }
      
      if (!confirm(`${rank}の画像をアップロードしますか？\n\nファイル: ${file.name}\nサイズ: ${(file.size / 1024).toFixed(1)} KB`)) {
        fileInput.value = '';
        return;
      }
      
      const formData = new FormData();
      formData.append('image', file);
      formData.append('benefitRank', rank);
      
      try {
        const response = await fetch('/api/upload-image', {
          method: 'POST',
          body: formData
        });
        
        const result = await response.json();
        
        if (result.success) {
          alert(`✅ 画像がアップロードされました！\n\nランク: ${result.benefitRank}\nファイル: ${result.filename}`);
          location.reload();
        } else {
          alert('❌ エラー: ' + result.message);
        }
      } catch (error) {
        alert('❌ 通信エラーが発生しました: ' + error.message);
      } finally {
        fileInput.value = '';
      }
    }
    
    async function deleteImage(rank) {
      if (!confirm(`${rank}の画像を削除しますか？`)) {
        return;
      }
      
      try {
        const response = await fetch(`/api/image/${encodeURIComponent(rank)}`, {
          method: 'DELETE'
        });
        
        const result = await response.json();
        
        if (result.success) {
          alert(`✅ 画像が削除されました！\n\nランク: ${result.benefitRank}`);
          location.reload();
        } else {
          alert('❌ エラー: ' + result.message);
        }
      } catch (error) {
        alert('❌ 通信エラーが発生しました: ' + error.message);
      }
    }
    
    async function sendTest() {
      const planType = document.getElementById('planType').value;
      const benefitRank = document.getElementById('benefitRank').value;
      
      if (!planType || !benefitRank) {
        alert('プランタイプと特典ランクを選択してください');
        return;
      }
      
      if (!confirm(`テスト送信しますか？\n\nプラン: ${planType}\nランク: ${benefitRank}`)) {
        return;
      }
      
      const btn = event.target;
      btn.disabled = true;
      btn.textContent = '⏳ 送信中...';
      
      try {
        const response = await fetch('/api/test-send', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({ planType, benefitRank })
        });
        
        const result = await response.json();
        
        if (result.success) {
          alert(`✅ テスト送信が完了しました！\n\nプラン: ${result.planType}\nランク: ${result.benefitRank}\n\nDiscordを確認してください。`);
          toggleTestForm();
        } else {
          alert('❌ エラー: ' + result.message);
        }
      } catch (error) {
        alert('❌ 通信エラーが発生しました: ' + error.message);
      } finally {
        btn.disabled = false;
        btn.textContent = '📤 テスト送信';
      }
    }
    
    async function runBatch() {
      if (!confirm('バッチ処理を手動実行しますか？')) return;
      
      const btn = event.target;
      btn.disabled = true;
      btn.textContent = '⏳ 実行中...';
      
      try {
        const response = await fetch('/api/run-batch', {
          method: 'POST'
        });
        
        const result = await response.json();
        
        if (result.success) {
          alert(`バッチ処理が完了しました\n\n成功: ${result.result.success}件\nスキップ: ${result.result.skipped}件\n失敗: ${result.result.failed}件`);
          location.reload();
        } else {
          alert('エラー: ' + result.message);
          btn.disabled = false;
          btn.textContent = '▶️ 手動実行';
        }
      } catch (error) {
        alert('通信エラーが発生しました: ' + error.message);
        btn.disabled = false;
        btn.textContent = '▶️ 手動実行';
      }
    }
    
    // 30秒ごとに自動リロード（処理中の場合）
    <% if (isProcessing) { %>
      setTimeout(() => location.reload(), 30000);
    <% } %>
  </script>
</body>
</html>
