<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WannaV ミッション管理</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', Meiryo, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 20px;
    }

    .container { max-width: 1400px; margin: 0 auto; }

    /* ヘッダー */
    .header {
      background: white;
      padding: 24px 30px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,.1);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }
    .header-left h1 { color: #667eea; font-size: 26px; margin-bottom: 4px; }
    .header-left p  { color: #666; font-size: 13px; }
    .header-nav { display: flex; gap: 10px; }
    .nav-link {
      display: inline-block;
      padding: 8px 18px;
      border-radius: 6px;
      font-size: 14px;
      text-decoration: none;
      background: #f0f2ff;
      color: #667eea;
      font-weight: 600;
      transition: background .2s;
    }
    .nav-link:hover { background: #667eea; color: white; }

    /* トグルスイッチ */
    .toggle-card {
      background: white;
      padding: 20px 28px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,.1);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    .toggle-label { font-size: 16px; font-weight: 700; color: #333; }
    .toggle-desc  { font-size: 13px; color: #666; margin-top: 2px; }
    .switch {
      position: relative;
      display: inline-block;
      width: 56px;
      height: 30px;
      flex-shrink: 0;
    }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider {
      position: absolute; inset: 0;
      background: #ccc;
      border-radius: 30px;
      cursor: pointer;
      transition: .3s;
    }
    .slider::before {
      content: '';
      position: absolute;
      width: 22px; height: 22px;
      left: 4px; top: 4px;
      background: white;
      border-radius: 50%;
      transition: .3s;
    }
    input:checked + .slider { background: #28a745; }
    input:checked + .slider::before { transform: translateX(26px); }
    .toggle-status-text { font-size: 14px; font-weight: 600; }
    .toggle-status-text.on  { color: #28a745; }
    .toggle-status-text.off { color: #999; }

    /* セクション共通 */
    .section {
      background: white;
      padding: 28px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,.1);
      margin-bottom: 28px;
    }
    .section h2 {
      font-size: 19px;
      color: #333;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 2px solid #667eea;
    }

    /* メッセージエディタ */
    .msg-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }
    .msg-card {
      border: 1px solid #dee2e6;
      border-radius: 8px;
      padding: 18px;
      background: #fafafa;
    }
    .msg-card h3 { font-size: 15px; font-weight: 700; color: #495057; margin-bottom: 10px; }
    .msg-card textarea {
      width: 100%;
      min-height: 160px;
      padding: 10px 12px;
      border: 1px solid #ced4da;
      border-radius: 6px;
      font-size: 13px;
      font-family: 'Consolas', 'Courier New', monospace;
      resize: vertical;
      line-height: 1.6;
    }
    .msg-card textarea:focus { outline: none; border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,.15); }
    .msg-hint { font-size: 11px; color: #888; margin-top: 6px; }
    .msg-save-btn {
      margin-top: 10px;
      padding: 8px 20px;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 13px;
      cursor: pointer;
      transition: background .2s;
    }
    .msg-save-btn:hover { background: #5568d3; }

    /* 生徒テーブル */
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 900px; }
    th {
      background: #667eea;
      color: white;
      padding: 11px 12px;
      text-align: left;
      font-weight: 600;
      white-space: nowrap;
    }
    td { padding: 11px 12px; border-bottom: 1px solid #eee; vertical-align: middle; }
    tr:hover td { background: #f8f9ff; }

    /* ミッションセル */
    .mission-cell { display: flex; flex-direction: column; gap: 5px; min-width: 130px; }
    .mission-date { font-size: 12px; color: #555; }
    .mission-date.not-sent { color: #bbb; font-style: italic; }

    /* チェックボックス */
    .check-wrap { display: flex; align-items: center; gap: 6px; }
    .mission-check {
      width: 18px; height: 18px;
      cursor: pointer;
      accent-color: #28a745;
    }
    .check-label { font-size: 12px; color: #555; }

    /* ミッション開始ボタン */
    .btn-start {
      padding: 6px 16px;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 5px;
      font-size: 13px;
      cursor: pointer;
      white-space: nowrap;
      transition: background .2s;
    }
    .btn-start:hover:not(:disabled) { background: #5568d3; }
    .btn-start:disabled { background: #b0b8f8; cursor: not-allowed; }
    .btn-restart {
      padding: 6px 14px;
      background: #6c757d;
      color: white;
      border: none;
      border-radius: 5px;
      font-size: 12px;
      cursor: pointer;
      margin-top: 4px;
      transition: background .2s;
    }
    .btn-restart:hover { background: #5a6268; }

    /* バッジ */
    .badge {
      display: inline-block;
      padding: 3px 10px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 600;
    }
    .badge-done     { background: #d4edda; color: #155724; }
    .badge-progress { background: #fff3cd; color: #856404; }
    .badge-none     { background: #f0f0f0; color: #999; }

    .empty-state { text-align: center; padding: 50px 20px; color: #999; font-size: 15px; }

    /* トースト通知 */
    #toast {
      position: fixed;
      bottom: 30px; right: 30px;
      padding: 14px 22px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      color: white;
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s;
      z-index: 9999;
      max-width: 340px;
    }
    #toast.show { opacity: 1; }
    #toast.success { background: #28a745; }
    #toast.error   { background: #dc3545; }
  </style>
</head>
<body>
<div class="container">

  <!-- ヘッダー -->
  <div class="header">
    <div class="header-left">
      <h1>🎯 ミッション管理</h1>
      <p>生徒様へのミッションメッセージを管理・送信します</p>
    </div>
    <div class="header-nav">
      <a href="/" class="nav-link">← 特典管理に戻る</a>
    </div>
  </div>

  <!-- ミッション機能 ON/OFF トグル -->
  <div class="toggle-card">
    <div>
      <div class="toggle-label">🔄 ミッション自動送信機能</div>
      <div class="toggle-desc">OFFにすると翌日15時の自動送信を停止します（ミッション開始ボタンは引き続き使用可）</div>
    </div>
    <label class="switch">
      <input type="checkbox" id="missionToggle" <%= missionEnabled ? 'checked' : '' %> onchange="toggleMission()">
      <span class="slider"></span>
    </label>
    <span class="toggle-status-text <%= missionEnabled ? 'on' : 'off' %>" id="toggleStatusText">
      <%= missionEnabled ? '✅ ON（毎日15時に自動送信）' : '⏸️ OFF（自動送信を停止中）' %>
    </span>
  </div>

  <!-- メッセージ編集 -->
  <div class="section">
    <h2>✏️ ミッションメッセージ編集</h2>
    <p style="font-size:13px;color:#666;margin-bottom:16px;">
      Discordのマークダウンに対応しています。<br>
      例: <code>**太字**</code> <code>__下線__</code> <code># 見出し</code> <code>&gt; 引用</code> <code>`コード`</code>
    </p>
    <div class="msg-grid">
      <% [1, 2, 3].forEach(no => {
        const msg = messages.find(m => m.mission_no === no);
        const content = msg ? msg.message_content : '';
      %>
        <div class="msg-card">
          <h3>ミッション <%= no %> のメッセージ</h3>
          <textarea id="msg<%= no %>" placeholder="ミッション <%= no %> のメッセージを入力..."><%= content %></textarea>
          <div class="msg-hint">
            <% if (no === 1) { %>📌 ミッション開始ボタンを押したときに送信されます
            <% } else { %>📌 ミッション<%= no-1 %>完了チェックの翌日15時に自動送信されます<% } %>
          </div>
          <button class="msg-save-btn" onclick="saveMessage(<%= no %>)">💾 保存</button>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- ミッション進捗テーブル -->
  <div class="section">
    <h2>📋 生徒別ミッション進捗</h2>
    <% if (sheetStudents && sheetStudents.length > 0) { %>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>氏名</th>
              <th>学籍番号</th>
              <th>ミッション1<br><span style="font-weight:400;font-size:11px;">送付日 / 完了</span></th>
              <th>ミッション2<br><span style="font-weight:400;font-size:11px;">送付日 / 完了</span></th>
              <th>ミッション3<br><span style="font-weight:400;font-size:11px;">送付日 / 完了</span></th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% sheetStudents.forEach(student => {
              const m = missionMap[student.studentId];
            %>
            <tr id="row-<%= student.studentId %>">
              <td><strong><%= student.studentName %></strong></td>
              <td style="color:#888;"><%= student.studentId %></td>

              <!-- ミッション1 -->
              <td>
                <div class="mission-cell">
                  <span class="mission-date <%= m && m.mission1_sent_at ? '' : 'not-sent' %>">
                    <%= m && m.mission1_sent_at
                      ? formatDateTime(new Date(m.mission1_sent_at)).substring(0, 7)
                      : '未送信' %>
                  </span>
                  <% if (m && m.mission1_sent_at) { %>
                    <div class="check-wrap">
                      <input type="checkbox" class="mission-check"
                        id="chk1-<%= student.studentId %>"
                        <%= m.mission1_completed ? 'checked' : '' %>
                        onchange="updateComplete('<%= student.studentId %>', 1, this.checked)">
                      <label class="check-label" for="chk1-<%= student.studentId %>">完了</label>
                    </div>
                  <% } else { %>
                    <span style="font-size:11px;color:#ccc;">-</span>
                  <% } %>
                </div>
              </td>

              <!-- ミッション2 -->
              <td>
                <div class="mission-cell">
                  <span class="mission-date <%= m && m.mission2_sent_at ? '' : 'not-sent' %>">
                    <%= m && m.mission2_sent_at
                      ? formatDateTime(new Date(m.mission2_sent_at)).substring(0, 7)
                      : (m && m.mission1_completed ? '⏳ 翌日15時送信予定' : '未送信') %>
                  </span>
                  <% if (m && m.mission2_sent_at) { %>
                    <div class="check-wrap">
                      <input type="checkbox" class="mission-check"
                        id="chk2-<%= student.studentId %>"
                        <%= m.mission2_completed ? 'checked' : '' %>
                        onchange="updateComplete('<%= student.studentId %>', 2, this.checked)">
                      <label class="check-label" for="chk2-<%= student.studentId %>">完了</label>
                    </div>
                  <% } else { %>
                    <span style="font-size:11px;color:#ccc;">-</span>
                  <% } %>
                </div>
              </td>

              <!-- ミッション3 -->
              <td>
                <div class="mission-cell">
                  <span class="mission-date <%= m && m.mission3_sent_at ? '' : 'not-sent' %>">
                    <%= m && m.mission3_sent_at
                      ? formatDateTime(new Date(m.mission3_sent_at)).substring(0, 7)
                      : (m && m.mission2_completed ? '⏳ 翌日15時送信予定' : '未送信') %>
                  </span>
                  <% if (m && m.mission3_sent_at) { %>
                    <div class="check-wrap">
                      <input type="checkbox" class="mission-check"
                        id="chk3-<%= student.studentId %>"
                        <%= m.mission3_completed ? 'checked' : '' %>
                        onchange="updateComplete('<%= student.studentId %>', 3, this.checked)">
                      <label class="check-label" for="chk3-<%= student.studentId %>">完了</label>
                    </div>
                  <% } else { %>
                    <span style="font-size:11px;color:#ccc;">-</span>
                  <% } %>
                </div>
              </td>

              <!-- 操作 -->
              <td>
                <% if (!m || !m.mission1_sent_at) { %>
                  <button class="btn-start"
                    onclick="startMission('<%= student.studentId %>', '<%= student.studentName.replace(/'/g, "\\'") %>', '<%= student.discordChannelUrl %>')"
                    <%= !student.discordChannelUrl ? 'disabled title="DiscordチャンネルURLが未設定です"' : '' %>>
                    ▶ ミッション開始
                  </button>
                  <% if (!student.discordChannelUrl) { %>
                    <div style="font-size:11px;color:#dc3545;margin-top:4px;">Discord未設定</div>
                  <% } %>
                <% } else { %>
                  <span class="badge <%= m.mission3_completed ? 'badge-done' : 'badge-progress' %>">
                    <%= m.mission3_completed ? '✅ 完了' : '🔄 進行中' %>
                  </span>
                  <br>
                  <button class="btn-restart"
                    onclick="restartMission('<%= student.studentId %>', '<%= student.studentName.replace(/'/g, "\\'") %>', '<%= student.discordChannelUrl %>')">
                    🔁 再開始
                  </button>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">📭 ❹オンボーディングシートに生徒データがありません</div>
    <% } %>
  </div>

</div>

<!-- トースト -->
<div id="toast"></div>

<script>
  // ========================================
  // トースト通知
  // ========================================
  function showToast(msg, type = 'success') {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = `show ${type}`;
    clearTimeout(t._timer);
    t._timer = setTimeout(() => { t.className = ''; }, 3000);
  }

  // ========================================
  // ミッション機能 ON/OFF トグル
  // ========================================
  async function toggleMission() {
    try {
      const res  = await fetch('/api/mission/toggle', { method: 'POST' });
      const data = await res.json();
      const text = document.getElementById('toggleStatusText');
      if (data.missionEnabled) {
        text.textContent = '✅ ON（毎日15時に自動送信）';
        text.className = 'toggle-status-text on';
        showToast('✅ ミッション自動送信をONにしました');
      } else {
        text.textContent = '⏸️ OFF（自動送信を停止中）';
        text.className = 'toggle-status-text off';
        showToast('⏸️ ミッション自動送信をOFFにしました', 'error');
      }
    } catch(e) {
      showToast('切り替えに失敗しました', 'error');
    }
  }

  // ========================================
  // メッセージ保存
  // ========================================
  async function saveMessage(no) {
    const content = document.getElementById(`msg${no}`).value;
    try {
      const res  = await fetch('/api/mission/message', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ missionNo: no, messageContent: content })
      });
      const data = await res.json();
      if (data.success) {
        showToast(`✅ ミッション${no}のメッセージを保存しました`);
      } else {
        showToast('保存に失敗しました: ' + data.message, 'error');
      }
    } catch(e) {
      showToast('通信エラーが発生しました', 'error');
    }
  }

  // ========================================
  // ミッション開始（ミッション1送信）
  // ========================================
  async function startMission(studentId, studentName, discordChannelUrl) {
    if (!confirm(`${studentName} さんのミッションを開始しますか？\nミッション1のメッセージを送信します。`)) return;
    try {
      const res  = await fetch('/api/mission/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentId, studentName, discordChannelUrl })
      });
      const data = await res.json();
      if (data.success) {
        showToast(`✅ ${studentName} さんへミッション1を送信しました`);
        setTimeout(() => location.reload(), 1200);
      } else {
        showToast('送信失敗: ' + data.error, 'error');
      }
    } catch(e) {
      showToast('通信エラーが発生しました', 'error');
    }
  }

  // ========================================
  // ミッション再開始
  // ========================================
  async function restartMission(studentId, studentName, discordChannelUrl) {
    if (!confirm(`${studentName} さんのミッションを最初からやり直しますか？\n現在の進捗はリセットされ、ミッション1を再送信します。`)) return;
    await startMission(studentId, studentName, discordChannelUrl);
  }

  // ========================================
  // ミッション完了チェック更新
  // ========================================
  async function updateComplete(studentId, missionNo, completed) {
    try {
      const res  = await fetch('/api/mission/complete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentId, missionNo, completed })
      });
      const data = await res.json();
      if (data.success) {
        const action = completed ? '完了' : '未完了';
        showToast(`✅ ミッション${missionNo}を${action}に更新しました`);
        // 送信予定テキストを更新するためページリロード
        setTimeout(() => location.reload(), 1200);
      } else {
        showToast('更新失敗: ' + data.message, 'error');
        // チェックを元に戻す
        document.getElementById(`chk${missionNo}-${studentId}`).checked = !completed;
      }
    } catch(e) {
      showToast('通信エラーが発生しました', 'error');
      document.getElementById(`chk${missionNo}-${studentId}`).checked = !completed;
    }
  }
</script>
</body>
</html>
