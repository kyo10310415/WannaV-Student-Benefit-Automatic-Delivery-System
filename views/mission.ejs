<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>WannaV ミッション管理</title>
  <style>
    * { margin: 0; padding: 0; box-sizing: border-box; }

    body {
      font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'Hiragino Sans', 'Hiragino Kaku Gothic ProN', Meiryo, sans-serif;
      background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
      min-height: 100vh;
      padding: 20px;
    }

    .container { max-width: 1400px; margin: 0 auto; }

    /* ヘッダー */
    .header {
      background: white;
      padding: 24px 30px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,.1);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 16px;
    }
    .header-left h1 { color: #667eea; font-size: 26px; margin-bottom: 4px; }
    .header-left p  { color: #666; font-size: 13px; }
    .header-nav { display: flex; gap: 10px; }
    .nav-link {
      display: inline-block;
      padding: 8px 18px;
      border-radius: 6px;
      font-size: 14px;
      text-decoration: none;
      background: #f0f2ff;
      color: #667eea;
      font-weight: 600;
      transition: background .2s;
    }
    .nav-link:hover { background: #667eea; color: white; }

    /* トグルスイッチ */
    .toggle-card {
      background: white;
      padding: 20px 28px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,.1);
      margin-bottom: 24px;
      display: flex;
      align-items: center;
      gap: 20px;
      flex-wrap: wrap;
    }
    .toggle-label { font-size: 16px; font-weight: 700; color: #333; }
    .toggle-desc  { font-size: 13px; color: #666; margin-top: 2px; }
    .switch {
      position: relative;
      display: inline-block;
      width: 56px;
      height: 30px;
      flex-shrink: 0;
    }
    .switch input { opacity: 0; width: 0; height: 0; }
    .slider {
      position: absolute; inset: 0;
      background: #ccc;
      border-radius: 30px;
      cursor: pointer;
      transition: .3s;
    }
    .slider::before {
      content: '';
      position: absolute;
      width: 22px; height: 22px;
      left: 4px; top: 4px;
      background: white;
      border-radius: 50%;
      transition: .3s;
    }
    input:checked + .slider { background: #28a745; }
    input:checked + .slider::before { transform: translateX(26px); }
    .toggle-status-text { font-size: 14px; font-weight: 600; }
    .toggle-status-text.on  { color: #28a745; }
    .toggle-status-text.off { color: #999; }

    /* セクション共通 */
    .section {
      background: white;
      padding: 28px;
      border-radius: 10px;
      box-shadow: 0 4px 6px rgba(0,0,0,.1);
      margin-bottom: 28px;
    }
    .section h2 {
      font-size: 19px;
      color: #333;
      margin-bottom: 20px;
      padding-bottom: 10px;
      border-bottom: 2px solid #667eea;
    }
    .section h2.reminder-h2 { border-bottom-color: #7c5cbf; }

    /* メッセージエディタ */
    .msg-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
      gap: 20px;
    }
    .msg-card {
      border: 1px solid #dee2e6;
      border-radius: 8px;
      padding: 18px;
      background: #fafafa;
    }
    .msg-card.reminder-card { border-color: #e2d9f3; background: #faf8ff; }
    .msg-card h3 { font-size: 15px; font-weight: 700; color: #495057; margin-bottom: 10px; }
    .msg-card h3.reminder-title { color: #5a3d8a; }
    .msg-card textarea {
      width: 100%;
      min-height: 160px;
      padding: 10px 12px;
      border: 1px solid #ced4da;
      border-radius: 6px;
      font-size: 13px;
      font-family: 'Consolas', 'Courier New', monospace;
      resize: vertical;
      line-height: 1.6;
    }
    .msg-card textarea:focus { outline: none; border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,.15); }
    .msg-card.reminder-card textarea:focus { border-color: #7c5cbf; box-shadow: 0 0 0 3px rgba(124,92,191,.15); }
    .msg-hint { font-size: 11px; color: #888; margin-top: 6px; }
    .msg-save-btn {
      margin-top: 10px;
      padding: 8px 20px;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 6px;
      font-size: 13px;
      cursor: pointer;
      transition: background .2s;
    }
    .msg-save-btn:hover { background: #5568d3; }
    .msg-save-btn.reminder-btn { background: #7c5cbf; }
    .msg-save-btn.reminder-btn:hover { background: #6a4dab; }

    /* 生徒テーブル */
    .table-wrap { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 13px; min-width: 960px; }
    th {
      background: #667eea;
      color: white;
      padding: 11px 12px;
      text-align: left;
      font-weight: 600;
      white-space: nowrap;
    }
    td { padding: 11px 12px; border-bottom: 1px solid #eee; vertical-align: middle; }
    tr:hover td { background: #f8f9ff; }

    /* ミッションセル */
    .mission-cell { display: flex; flex-direction: column; gap: 5px; min-width: 140px; }
    .mission-date { font-size: 12px; color: #555; }
    .mission-date.not-sent { color: #bbb; font-style: italic; }

    /* チェックボックス */
    .check-wrap { display: flex; align-items: center; gap: 6px; }
    .mission-check {
      width: 18px; height: 18px;
      cursor: pointer;
      accent-color: #28a745;
    }
    .check-label { font-size: 12px; color: #555; }

    /* ミッション開始ボタン */
    .btn-start {
      padding: 6px 16px;
      background: #667eea;
      color: white;
      border: none;
      border-radius: 5px;
      font-size: 13px;
      cursor: pointer;
      white-space: nowrap;
      transition: background .2s;
    }
    .btn-start:hover:not(:disabled) { background: #5568d3; }
    .btn-start:disabled { background: #b0b8f8; cursor: not-allowed; }
    .btn-restart {
      padding: 6px 14px;
      background: #6c757d;
      color: white;
      border: none;
      border-radius: 5px;
      font-size: 12px;
      cursor: pointer;
      margin-top: 4px;
      transition: background .2s;
    }
    .btn-restart:hover { background: #5a6268; }

    /* バッジ */
    .badge {
      display: inline-block;
      padding: 3px 8px;
      border-radius: 10px;
      font-size: 11px;
      font-weight: 600;
    }
    .badge-done     { background: #d4edda; color: #155724; }
    .badge-progress { background: #fff3cd; color: #856404; }
    .badge-none     { background: #f0f0f0; color: #999; }
    .badge-reminded { background: #e2d9f3; color: #5a3d8a; }

    /* リマインドヒント */
    .reminder-hint { font-size: 11px; color: #e07b00; margin-top: 3px; font-style: italic; }

    /* Discord リンクアイコン */
    .discord-link {
      display: inline-flex;
      align-items: center;
      margin-left: 6px;
      color: #5865f2;
      text-decoration: none;
      opacity: .7;
      transition: opacity .2s;
      vertical-align: middle;
    }
    .discord-link:hover { opacity: 1; }
    .discord-link svg { width: 14px; height: 14px; }

    /* 検索バー */
    .search-bar-wrap {
      display: flex;
      align-items: center;
      gap: 10px;
      margin-bottom: 18px;
      flex-wrap: wrap;
    }
    .search-input-wrap {
      position: relative;
      flex: 1;
      min-width: 200px;
      max-width: 360px;
    }
    .search-input-wrap .search-icon {
      position: absolute;
      left: 11px;
      top: 50%;
      transform: translateY(-50%);
      color: #aaa;
      font-size: 15px;
      pointer-events: none;
    }
    .search-input {
      width: 100%;
      padding: 9px 12px 9px 34px;
      border: 1px solid #ced4da;
      border-radius: 7px;
      font-size: 14px;
      outline: none;
      transition: border-color .2s, box-shadow .2s;
    }
    .search-input:focus {
      border-color: #667eea;
      box-shadow: 0 0 0 3px rgba(102,126,234,.15);
    }
    .search-clear {
      position: absolute;
      right: 9px;
      top: 50%;
      transform: translateY(-50%);
      background: none;
      border: none;
      color: #aaa;
      font-size: 16px;
      cursor: pointer;
      line-height: 1;
      padding: 0 2px;
      display: none;
    }
    .search-clear:hover { color: #555; }
    .search-count { font-size: 13px; color: #888; white-space: nowrap; }
    .search-count strong { color: #667eea; }
    tr.hidden-row { display: none; }
    mark { background: #fff176; color: inherit; border-radius: 2px; padding: 0 1px; }

    .empty-state { text-align: center; padding: 50px 20px; color: #999; font-size: 15px; }

    /* 月別達成率 */
    .stats-toolbar {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 16px;
      margin-bottom: 20px;
      flex-wrap: wrap;
    }
    .stats-definition { color: #666; font-size: 12px; line-height: 1.7; max-width: 760px; }
    .stats-filter { display: flex; align-items: flex-end; gap: 8px; }
    .stats-filter label { display: flex; flex-direction: column; gap: 5px; color: #555; font-size: 12px; font-weight: 700; }
    .month-input {
      min-height: 40px;
      padding: 7px 11px;
      border: 1px solid #ced4da;
      border-radius: 7px;
      background: white;
      color: #333;
      font-size: 14px;
    }
    .month-input:focus { outline: none; border-color: #667eea; box-shadow: 0 0 0 3px rgba(102,126,234,.15); }
    .stats-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(180px, 1fr));
      gap: 14px;
      margin-bottom: 28px;
    }
    .stat-card {
      padding: 18px;
      border: 1px solid #e4e7f5;
      border-radius: 10px;
      background: linear-gradient(180deg, #fbfbff 0%, #f7f8ff 100%);
    }
    .stat-card.overall { color: white; border: 0; background: linear-gradient(135deg, #667eea, #764ba2); }
    .stat-label { font-size: 12px; font-weight: 700; opacity: .8; }
    .stat-rate { display: flex; align-items: baseline; gap: 5px; margin: 8px 0 10px; }
    .stat-rate strong { font-size: 30px; line-height: 1; }
    .stat-rate span { font-size: 14px; font-weight: 700; }
    .stat-count { font-size: 11px; opacity: .8; }
    .stat-progress { height: 7px; margin-top: 12px; overflow: hidden; border-radius: 8px; background: rgba(102,126,234,.15); }
    .stat-card.overall .stat-progress { background: rgba(255,255,255,.25); }
    .stat-progress-bar { height: 100%; border-radius: 8px; background: #667eea; }
    .stat-card.overall .stat-progress-bar { background: white; }
    .history-heading { margin: 4px 0 12px; color: #444; font-size: 15px; }
    .history-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 4px 0 12px;
      flex-wrap: wrap;
    }
    .history-header .history-heading { margin: 0; }
    .csv-export-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 38px;
      padding: 8px 14px;
      border: 1px solid #667eea;
      border-radius: 7px;
      background: #667eea;
      color: white;
      font-size: 13px;
      font-weight: 700;
      text-decoration: none;
      transition: background .2s, border-color .2s;
    }
    .csv-export-btn:hover { border-color: #5568d3; background: #5568d3; }
    .csv-export-btn.disabled { border-color: #ccc; background: #ccc; cursor: not-allowed; }
    .stats-table { min-width: 720px; }
    .stats-table th { background: #545b78; text-align: center; }
    .stats-table th:first-child, .stats-table td:first-child { text-align: left; }
    .stats-table td { text-align: center; }
    .rate-value { display: block; color: #495057; font-size: 15px; font-weight: 800; }
    .rate-detail { display: block; margin-top: 2px; color: #999; font-size: 10px; }

    @media (max-width: 900px) {
      .stats-grid { grid-template-columns: repeat(2, minmax(160px, 1fr)); }
    }
    @media (max-width: 520px) {
      .stats-grid { grid-template-columns: 1fr; }
      .stats-filter, .stats-filter label, .month-input { width: 100%; }
      .history-header, .csv-export-btn { width: 100%; }
    }

    /* テスト送信 */
    .test-send-card {
      background: #fffdf0;
      border: 2px solid #ffc107;
      border-radius: 10px;
      padding: 24px 28px;
      margin-bottom: 28px;
    }
    .test-send-card h2 {
      font-size: 17px;
      color: #856404;
      margin-bottom: 6px;
    }
    .test-send-desc {
      font-size: 12px;
      color: #888;
      margin-bottom: 18px;
      line-height: 1.6;
    }
    .test-send-desc code {
      background: #f0f0f0;
      padding: 1px 6px;
      border-radius: 4px;
      font-size: 11px;
      overflow-wrap: anywhere;
      word-break: break-all;
    }
    .test-send-row {
      display: flex;
      align-items: center;
      gap: 12px;
      flex-wrap: wrap;
    }
    .test-mission-btns { display: flex; gap: 10px; flex-wrap: wrap; }
    .btn-test {
      padding: 9px 22px;
      border: none;
      border-radius: 6px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      transition: background .2s, transform .1s;
      white-space: nowrap;
    }
    .btn-test:active { transform: scale(.97); }
    .btn-test:disabled { opacity: .5; cursor: not-allowed; }
    .btn-test-1 { background: #667eea; color: white; }
    .btn-test-1:hover:not(:disabled) { background: #5568d3; }
    .btn-test-2 { background: #28a745; color: white; }
    .btn-test-2:hover:not(:disabled) { background: #218838; }
    .btn-test-3 { background: #fd7e14; color: white; }
    .btn-test-3:hover:not(:disabled) { background: #e8690a; }
    .test-send-info {
      font-size: 12px;
      color: #888;
      padding: 8px 14px;
      background: #f8f9fa;
      border-radius: 6px;
      line-height: 1.7;
      flex: 1;
      min-width: 200px;
    }
    .test-send-info span { font-weight: 600; color: #555; }

    /* トースト通知 */
    #toast {
      position: fixed;
      bottom: 30px; right: 30px;
      padding: 14px 22px;
      border-radius: 8px;
      font-size: 14px;
      font-weight: 600;
      color: white;
      opacity: 0;
      pointer-events: none;
      transition: opacity .3s;
      z-index: 9999;
      max-width: 340px;
    }
    #toast.show { opacity: 1; }
    #toast.success { background: #28a745; }
    #toast.error   { background: #dc3545; }
  </style>
</head>
<body>
<div class="container">

  <!-- ヘッダー -->
  <div class="header">
    <div class="header-left">
      <h1>🎯 ミッション管理</h1>
      <p>生徒様へのミッションメッセージを管理・送信します</p>
    </div>
    <div class="header-nav">
      <a href="/" class="nav-link">← 特典管理に戻る</a>
    </div>
  </div>

  <!-- ミッション機能 ON/OFF トグル -->
  <div class="toggle-card">
    <div>
      <div class="toggle-label">🔄 ミッション自動送信機能</div>
      <div class="toggle-desc">OFFにすると翌日15時の自動送信・リマインド送信を停止します（ミッション開始ボタンは引き続き使用可）</div>
    </div>
    <label class="switch">
      <input type="checkbox" id="missionToggle" <%= missionEnabled ? 'checked' : '' %> onchange="toggleMission()">
      <span class="slider"></span>
    </label>
    <span class="toggle-status-text <%= missionEnabled ? 'on' : 'off' %>" id="toggleStatusText">
      <%= missionEnabled ? '✅ ON（毎日15時に自動送信）' : '⏸️ OFF（自動送信を停止中）' %>
    </span>
  </div>

  <!-- 月別ミッション達成率 -->
  <div class="section">
    <h2>📊 月別ミッション達成率</h2>
    <div class="stats-toolbar">
      <p class="stats-definition">
        選択月に送付したミッションを対象に、現在完了済みの件数から達成率を計算します。<br>
        達成率 ＝ 完了件数 ÷ 送付件数（再開始した場合も各送付履歴を保持して集計）
      </p>
      <form method="get" action="/mission" class="stats-filter">
        <label for="statsMonth">
          表示する年月
          <input type="month" id="statsMonth" name="month" class="month-input"
            value="<%= missionStats.selectedMonth %>" onchange="this.form.submit()" required>
        </label>
        <noscript><button type="submit" class="msg-save-btn">表示</button></noscript>
      </form>
    </div>

    <h3 class="history-heading"><%= missionStats.selected.monthLabel %> の結果</h3>
    <div class="stats-grid">
      <%
        const statCards = [
          { label: '全体', data: missionStats.selected.overall, overall: true },
          { label: 'ミッション1', data: missionStats.selected.missions[1] },
          { label: 'ミッション2', data: missionStats.selected.missions[2] },
          { label: 'ミッション3', data: missionStats.selected.missions[3] }
        ];
        statCards.forEach(card => {
      %>
        <div class="stat-card <%= card.overall ? 'overall' : '' %>">
          <div class="stat-label"><%= card.label %></div>
          <div class="stat-rate">
            <strong><%= card.data.achievementRate %></strong><span>%</span>
          </div>
          <div class="stat-count">
            完了 <%= card.data.completedCount %> / 送付 <%= card.data.sentCount %> 件
            <% if (card.overall) { %>・対象 <%= card.data.studentCount %> 名<% } %>
          </div>
          <div class="stat-progress" aria-hidden="true">
            <div class="stat-progress-bar" style="width:<%= card.data.achievementRate %>%;"></div>
          </div>
        </div>
      <% }); %>
    </div>

    <div class="history-header">
      <h3 class="history-heading">過去のデータ（全期間）</h3>
      <% if (missionStats.monthly.length > 0) { %>
        <a href="/api/mission/stats.csv" class="csv-export-btn" download>
          ⬇ CSVエクスポート
        </a>
      <% } else { %>
        <span class="csv-export-btn disabled" aria-disabled="true">⬇ CSVエクスポート</span>
      <% } %>
    </div>
    <% if (missionStats.monthly.length > 0) { %>
      <div class="table-wrap">
        <table class="stats-table">
          <thead>
            <tr>
              <th>年月</th>
              <th>対象生徒</th>
              <th>全体</th>
              <th>ミッション1</th>
              <th>ミッション2</th>
              <th>ミッション3</th>
            </tr>
          </thead>
          <tbody>
            <% missionStats.monthly.forEach(monthStat => { %>
              <tr>
                <td><strong><%= monthStat.monthLabel %></strong></td>
                <td><%= monthStat.overall.studentCount %> 名</td>
                <% [monthStat.overall, monthStat.missions[1], monthStat.missions[2], monthStat.missions[3]].forEach(stat => { %>
                  <td>
                    <span class="rate-value"><%= stat.achievementRate %>%</span>
                    <span class="rate-detail"><%= stat.completedCount %> / <%= stat.sentCount %> 件</span>
                  </td>
                <% }); %>
              </tr>
            <% }); %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">📭 集計できるミッション送付履歴がまだありません</div>
    <% } %>
  </div>

  <!-- テスト送信 -->
  <div class="test-send-card">
    <h2>⚡ テスト送信</h2>
    <div class="test-send-desc">
      固定のテスト送信先（<code>https://discord.com/channels/1176426605309083678/1293539258069417994</code>）に送信します。<br>
      DB記録はされません。<code>◯月◯日</code> の置換も実際の送信と同様に動作します。
    </div>
    <div class="test-send-row">
      <div class="test-mission-btns">
        <button class="btn-test btn-test-1" onclick="testSendMission(1)">🧪 ミッション1 テスト</button>
        <button class="btn-test btn-test-2" onclick="testSendMission(2)">🧪 ミッション2 テスト</button>
        <button class="btn-test btn-test-3" onclick="testSendMission(3)">🧪 ミッション3 テスト</button>
      </div>
      <div class="test-send-info">
        <span>送信先チャンネル：</span> 1293539258069417994<br>
        <span>メンション先：</span> &lt;@766666980086120470&gt;
      </div>
    </div>
  </div>

  <!-- ミッションメッセージ編集 -->
  <div class="section">
    <h2>✏️ ミッションメッセージ編集</h2>
    <p style="font-size:13px;color:#666;margin-bottom:16px;">
      Discordのマークダウンに対応しています。<br>
      例: <code>**太字**</code> <code>__下線__</code> <code># 見出し</code> <code>&gt; 引用</code> <code>`コード`</code>
    </p>
    <div class="msg-grid">
      <% [1, 2, 3].forEach(no => {
        const msg = messages.find(m => m.mission_no === no);
        const content = msg ? msg.message_content : '';
      %>
        <div class="msg-card">
          <h3>ミッション <%= no %> のメッセージ</h3>
          <textarea id="msg<%= no %>" placeholder="ミッション <%= no %> のメッセージを入力..."><%= content %></textarea>
          <div class="msg-hint">
            <% if (no === 1) { %>📌 ミッション開始ボタンを押したときに送信されます
            <% } else { %>📌 ミッション<%= no-1 %>完了チェックの翌日15時に自動送信されます<% } %>
          </div>
          <button class="msg-save-btn" onclick="saveMessage(<%= no %>)">💾 保存</button>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- リマインドメッセージ編集 -->
  <div class="section">
    <h2 class="reminder-h2">🔔 リマインドメッセージ編集</h2>
    <p style="font-size:13px;color:#666;margin-bottom:16px;">
      ミッション送付日から <strong>3日後</strong> までに完了チェックが入らなかった場合、毎日15時30分に <strong>1回だけ</strong> 自動送信されます。<br>
      空欄のミッションはリマインドをスキップします。<code>◯月◯日</code> の自動置換も同様に動作します。
    </p>
    <div class="msg-grid">
      <% [1, 2, 3].forEach(no => {
        const rmsg = reminderMessages.find(m => m.mission_no === no);
        const rcontent = rmsg ? rmsg.message_content : '';
      %>
        <div class="msg-card reminder-card">
          <h3 class="reminder-title">🔔 ミッション <%= no %> のリマインド</h3>
          <textarea id="reminder<%= no %>" placeholder="ミッション <%= no %> 完了チェック促進メッセージ（空欄でスキップ）..."><%= rcontent %></textarea>
          <div class="msg-hint">📌 送付日3日後まで未完了の場合に1回だけ送信されます</div>
          <button class="msg-save-btn reminder-btn" onclick="saveReminderMessage(<%= no %>)">💾 保存</button>
        </div>
      <% }) %>
    </div>
  </div>

  <!-- ミッション進捗テーブル -->
  <div class="section">
    <h2>📋 生徒別ミッション進捗</h2>
    <% if (sheetStudents && sheetStudents.length > 0) { %>
      <!-- 検索バー -->
      <div class="search-bar-wrap">
        <div class="search-input-wrap">
          <span class="search-icon">🔍</span>
          <input type="text" id="studentSearch" class="search-input"
            placeholder="氏名・学籍番号で検索..."
            oninput="filterStudents(this.value)"
            autocomplete="off">
          <button class="search-clear" id="searchClear" onclick="clearSearch()">✕</button>
        </div>
        <div class="search-count" id="searchCount"></div>
      </div>
      <div class="table-wrap">
        <table>
          <thead>
            <tr>
              <th>氏名</th>
              <th>学籍番号</th>
              <th>プラン</th>
              <th>ミッション1<br><span style="font-weight:400;font-size:11px;">送付日 / 完了 / リマインド</span></th>
              <th>ミッション2<br><span style="font-weight:400;font-size:11px;">送付日 / 完了 / リマインド</span></th>
              <th>ミッション3<br><span style="font-weight:400;font-size:11px;">送付日 / 完了 / リマインド</span></th>
              <th>操作</th>
            </tr>
          </thead>
          <tbody>
            <% sheetStudents.forEach(student => {
              const m = missionMap[student.studentId];
            %>
            <tr id="row-<%= student.studentId %>"
              data-name="<%= student.studentName %>"
              data-sid="<%= student.studentId %>">

              <!-- 氏名 + Discordリンク -->
              <td>
                <strong class="cell-name"><%= student.studentName %></strong>
                <% if (student.discordChannelUrl) { %>
                  <a href="<%= student.discordChannelUrl %>" target="_blank" rel="noopener"
                    class="discord-link" title="Discordチャンネルを開く">
                    <svg viewBox="0 0 24 24" fill="currentColor">
                      <path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057c.002.022.015.043.031.056a19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/>
                    </svg>
                  </a>
                <% } %>
              </td>

              <!-- 学籍番号 -->
              <td style="color:#888;"><span class="cell-sid"><%= student.studentId %></span></td>

              <!-- プラン -->
              <%
                const planName = (m && m.plan_type) ? m.plan_type : (student.planType || '');
                const isEntry  = planName === 'エントリープラン';
              %>
              <td>
                <% if (planName) { %>
                  <span style="display:inline-block;padding:3px 8px;border-radius:10px;font-size:11px;font-weight:700;
                    background:<%= isEntry ? '#fff3e0' : '#e3f0ff' %>;
                    color:<%= isEntry ? '#e65100' : '#1565c0' %>;">
                    <%= planName %>
                  </span>
                <% } else { %>
                  <span style="color:#ccc;font-size:11px;">-</span>
                <% } %>
              </td>

              <!-- ミッション1〜3 ループ -->
              <% [1, 2, 3].forEach(function(no) {
                const sentKey      = 'mission' + no + '_sent_at';
                const completedKey = 'mission' + no + '_completed';
                const remindedKey  = 'mission' + no + '_reminded_at';
                const prevCompKey  = 'mission' + (no - 1) + '_completed';
                const isSent      = m && m[sentKey];
                const isCompleted = m && m[completedKey];
                const isReminded  = m && m[remindedKey];
                const prevDone    = no === 1 ? true : (m && m[prevCompKey]);
                // エントリープランはミッション2をスキップ
                const isSkipped   = isEntry && no === 2;
              %>
              <td>
                <% if (isSkipped) { %>
                  <!-- エントリープラン: ミッション2スキップ表示 -->
                  <div class="mission-cell">
                    <span style="display:inline-block;padding:3px 8px;border-radius:8px;
                      background:#f5f5f5;color:#aaa;font-size:11px;font-weight:600;">スキップ</span>
                  </div>
                <% } else { %>
                <div class="mission-cell">
                  <!-- 送付日 or ステータス -->
                  <span class="mission-date <%= isSent ? '' : 'not-sent' %>">
                    <% if (isSent) { %>
                      <%= formatDateTime(new Date(m[sentKey])).substring(0, 7) %>
                    <% } else if (no === 3 && isEntry && m && m.mission1_completed) { %>
                      ⏳ 翌日15時送信予定
                    <% } else if (no > 1 && !isEntry && prevDone) { %>
                      ⏳ 翌日15時送信予定
                    <% } else { %>
                      未送信
                    <% } %>
                  </span>

                  <% if (isSent) { %>
                    <!-- 完了チェック -->
                    <div class="check-wrap">
                      <input type="checkbox" class="mission-check"
                        id="chk<%= no %>-<%= student.studentId %>"
                        <%= isCompleted ? 'checked' : '' %>
                        onchange="updateComplete('<%= student.studentId %>', <%= no %>, this.checked)">
                      <label class="check-label" for="chk<%= no %>-<%= student.studentId %>">完了</label>
                    </div>
                    <!-- リマインド状態 -->
                    <% if (isReminded) { %>
                      <span class="badge badge-reminded">🔔 リマインド済</span>
                    <% } else if (!isCompleted) { %>
                      <span class="reminder-hint">⏰ 3日後未完了でリマインド</span>
                    <% } %>
                  <% } else { %>
                    <span style="font-size:11px;color:#ccc;">-</span>
                  <% } %>
                </div>
                <% } %>
              </td>
              <% }); %>

              <!-- 操作 -->
              <td>
                <% if (!m || !m.mission1_sent_at) { %>
                  <button class="btn-start"
                    onclick="startMission('<%= student.studentId %>', '<%= student.studentName.replace(/'/g, "\\'") %>', '<%= student.discordChannelUrl %>', '<%= (student.planType || '').replace(/'/g, "\\'") %>')"
                    <%= !student.discordChannelUrl ? 'disabled title="DiscordチャンネルURLが未設定です"' : '' %>>
                    ▶ ミッション開始
                  </button>
                  <% if (!student.discordChannelUrl) { %>
                    <div style="font-size:11px;color:#dc3545;margin-top:4px;">Discord未設定</div>
                  <% } %>
                <% } else { %>
                  <span class="badge <%= m.mission3_completed ? 'badge-done' : 'badge-progress' %>">
                    <%= m.mission3_completed ? '✅ 完了' : '🔄 進行中' %>
                  </span>
                  <br>
                  <button class="btn-restart"
                    onclick="restartMission('<%= student.studentId %>', '<%= student.studentName.replace(/'/g, "\\'") %>', '<%= student.discordChannelUrl %>', '<%= (student.planType || '').replace(/'/g, "\\'") %>')">
                    🔁 再開始
                  </button>
                <% } %>
              </td>
            </tr>
            <% }) %>
          </tbody>
        </table>
      </div>
    <% } else { %>
      <div class="empty-state">📭 ❹オンボーディングシートに生徒データがありません</div>
    <% } %>
  </div>

</div>

<!-- トースト -->
<div id="toast"></div>

<script>
  // ========================================
  // トースト通知
  // ========================================
  function showToast(msg, type = 'success') {
    const t = document.getElementById('toast');
    t.textContent = msg;
    t.className = `show ${type}`;
    clearTimeout(t._timer);
    t._timer = setTimeout(() => { t.className = ''; }, 3000);
  }

  // ========================================
  // テスト送信
  // ========================================
  async function testSendMission(no) {
    const btns = document.querySelectorAll('.btn-test');
    btns.forEach(b => b.disabled = true);
    showToast(`⏳ ミッション${no} テスト送信中...`, 'success');
    try {
      const res  = await fetch('/api/mission/test-send', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ missionNo: no })
      });
      const data = await res.json();
      if (data.success) {
        const dateInfo = data.tomorrowLabel ? `（◯月◯日 → ${data.tomorrowLabel}）` : '';
        showToast(`✅ ミッション${no} テスト送信完了 ${dateInfo}`);
      } else {
        showToast('❌ 送信失敗: ' + (data.message || data.error), 'error');
      }
    } catch(e) {
      showToast('通信エラーが発生しました', 'error');
    } finally {
      btns.forEach(b => b.disabled = false);
    }
  }

  // ========================================
  // 生徒検索フィルター
  // ========================================
  const totalRows = document.querySelectorAll('tbody tr[data-name]').length;

  function filterStudents(q) {
    const keyword = q.trim().toLowerCase();
    const clearBtn = document.getElementById('searchClear');
    const countEl  = document.getElementById('searchCount');
    clearBtn.style.display = keyword ? 'block' : 'none';
    let visible = 0;
    document.querySelectorAll('tbody tr[data-name]').forEach(row => {
      const name = row.dataset.name.toLowerCase();
      const sid  = row.dataset.sid.toLowerCase();
      const hit  = !keyword || name.includes(keyword) || sid.includes(keyword);
      row.classList.toggle('hidden-row', !hit);
      if (hit) {
        visible++;
        highlightCell(row.querySelector('.cell-name'), row.dataset.name, keyword);
        highlightCell(row.querySelector('.cell-sid'),  row.dataset.sid,  keyword);
      } else {
        resetCell(row.querySelector('.cell-name'), row.dataset.name);
        resetCell(row.querySelector('.cell-sid'),  row.dataset.sid);
      }
    });
    countEl.innerHTML = keyword ? `<strong>${visible}</strong> / ${totalRows} 件` : '';
  }

  function highlightCell(el, original, keyword) {
    if (!el || !keyword) return;
    const escaped = keyword.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    el.innerHTML = original.replace(new RegExp(`(${escaped})`, 'gi'), '<mark>$1</mark>');
  }

  function resetCell(el, original) {
    if (el) el.textContent = original;
  }

  function clearSearch() {
    const input = document.getElementById('studentSearch');
    input.value = '';
    filterStudents('');
    input.focus();
  }

  // ========================================
  // ミッション機能 ON/OFF トグル
  // ========================================
  async function toggleMission() {
    try {
      const res  = await fetch('/api/mission/toggle', { method: 'POST' });
      const data = await res.json();
      const text = document.getElementById('toggleStatusText');
      if (data.missionEnabled) {
        text.textContent = '✅ ON（毎日15時に自動送信）';
        text.className = 'toggle-status-text on';
        showToast('✅ ミッション自動送信をONにしました');
      } else {
        text.textContent = '⏸️ OFF（自動送信を停止中）';
        text.className = 'toggle-status-text off';
        showToast('⏸️ ミッション自動送信をOFFにしました', 'error');
      }
    } catch(e) {
      showToast('切り替えに失敗しました', 'error');
    }
  }

  // ========================================
  // ミッションメッセージ保存
  // ========================================
  async function saveMessage(no) {
    const content = document.getElementById(`msg${no}`).value;
    try {
      const res  = await fetch('/api/mission/message', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ missionNo: no, messageContent: content })
      });
      const data = await res.json();
      if (data.success) {
        showToast(`✅ ミッション${no}のメッセージを保存しました`);
      } else {
        showToast('保存に失敗しました: ' + data.message, 'error');
      }
    } catch(e) {
      showToast('通信エラーが発生しました', 'error');
    }
  }

  // ========================================
  // リマインドメッセージ保存
  // ========================================
  async function saveReminderMessage(no) {
    const content = document.getElementById(`reminder${no}`).value;
    try {
      const res  = await fetch('/api/mission/reminder-message', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ missionNo: no, messageContent: content })
      });
      const data = await res.json();
      if (data.success) {
        showToast(`✅ ミッション${no}のリマインドメッセージを保存しました`);
      } else {
        showToast('保存に失敗しました: ' + data.message, 'error');
      }
    } catch(e) {
      showToast('通信エラーが発生しました', 'error');
    }
  }

  // ========================================
  // ミッション開始（ミッション1送信）
  // ========================================
  async function startMission(studentId, studentName, discordChannelUrl, planType) {
    const isEntry = planType === 'エントリープラン';
    const planNote = isEntry ? '\n※エントリープランのためミッション1完了後はミッション3へ進みます' : '';
    if (!confirm(`${studentName} さんのミッションを開始しますか？\nミッション1のメッセージを送信します。${planNote}`)) return;
    try {
      const res  = await fetch('/api/mission/start', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentId, studentName, discordChannelUrl, planType })
      });
      const data = await res.json();
      if (data.success) {
        showToast(`✅ ${studentName} さんへミッション1を送信しました`);
        setTimeout(() => location.reload(), 1200);
      } else {
        showToast('送信失敗: ' + data.error, 'error');
      }
    } catch(e) {
      showToast('通信エラーが発生しました', 'error');
    }
  }

  // ========================================
  // ミッション再開始
  // ========================================
  async function restartMission(studentId, studentName, discordChannelUrl, planType) {
    const isEntry = planType === 'エントリープラン';
    const planNote = isEntry ? '\n※エントリープランのためミッション1完了後はミッション3へ進みます' : '';
    if (!confirm(`${studentName} さんのミッションを最初からやり直しますか？\n現在の進捗はリセットされ、ミッション1を再送信します。${planNote}`)) return;
    await startMission(studentId, studentName, discordChannelUrl, planType);
  }

  // ========================================
  // ミッション完了チェック更新
  // ========================================
  async function updateComplete(studentId, missionNo, completed) {
    try {
      const res  = await fetch('/api/mission/complete', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ studentId, missionNo, completed })
      });
      const data = await res.json();
      if (data.success) {
        showToast(`✅ ミッション${missionNo}を${completed ? '完了' : '未完了'}に更新しました`);
        setTimeout(() => location.reload(), 1200);
      } else {
        showToast('更新失敗: ' + data.message, 'error');
        document.getElementById(`chk${missionNo}-${studentId}`).checked = !completed;
      }
    } catch(e) {
      showToast('通信エラーが発生しました', 'error');
      document.getElementById(`chk${missionNo}-${studentId}`).checked = !completed;
    }
  }
</script>
</body>
</html>
